<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:padding="12dp" android:gravity="center_vertical"
    android:background="#FFFFFF">
    <LinearLayout android:layout_width="52dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
        <TextView android:id="@+id/hari" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="21sp" android:textStyle="bold" android:textColor="#16324F" />
        <TextView android:id="@+id/bulan" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="11sp" android:textColor="#5B7186" />
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical" android:layout_marginStart="10dp">
        <TextView android:id="@+id/nama" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="15.5sp" android:textStyle="bold" android:textColor="#16324F" />
        <TextView android:id="@+id/jumlah" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="14sp" android:textStyle="bold" android:layout_marginTop="1dp" />
        <TextView android:id="@+id/sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="#5B7186" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Berhasil" android:textSize="11sp" android:textColor="#177245"
            android:background="@drawable/bg_pill_hijau" android:paddingStart="8dp" android:paddingEnd="8dp"
            android:paddingTop="2dp" android:paddingBottom="2dp" android:layout_marginTop="4dp" />
    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="›" android:textSize="22sp" android:textColor="#9FB6CC" />
</LinearLayout>
